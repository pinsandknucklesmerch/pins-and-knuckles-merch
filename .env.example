# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Direct Postgres connection string used for local database backup/maintenance scripts.
DIRECT_DATABASE_URL=

# Separate restore target only; use a disposable/local/test PostgreSQL database, never production.
RESTORE_DATABASE_URL=

# Optional local-only owner connection for auth.users cleanup (commonly supabase_auth_admin).
# Use only a disposable local Supabase database; never set this to production.
RESTORE_ADMIN_DATABASE_URL=

# Server-only Supabase service-role key used for privileged team provisioning. Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Monday.com token for read-only historical KPI discovery. Never use NEXT_PUBLIC_.
MONDAY_API_TOKEN=your-monday-api-token
# Optional: set only after board discovery confirms the mapping.
MONDAY_SALES_BOARD_ID=
MONDAY_QUOTES_BOARD_ID=
MONDAY_ORDERS_BOARD_ID=
# Server-only Snuggle Orders board ID; verify the board name and workspace before setting.
MONDAY_SNUGGLE_BOARD_ID=18393924380

# Server-only Google OAuth credentials for the Gmail EPCC profit importer.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_REPORT_ADDRESS=

# Server-only GA4 access via Vercel OIDC -> Google Workload Identity Federation.
# No long-lived Google service-account key is used.
GA4_PROPERTY_ID=
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=

# Server-only bearer secret used by Vercel Cron.
CRON_SECRET=
